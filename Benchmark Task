    "import kaggle_benchmarks as kbench\n",
    "\n",
    "@kbench.task(name=\"chess mate in 2 puzzle\")\n",
    "def chess_mate_in_2_puzzle(llm):\n",
    "    fen = \"3q2r1/4n2k/p1p1rBpp/PpPpPp2/1P3P1Q/2P3R1/7P/1R5K w - - 1 0\"\n",
    "    board_ascii = \"\"\"\n",
    ". . . q . . r .\n",
    ". . . . n . . k\n",
    "p . p . r B p p\n",
    "P p P p P p . .\n",
    ". . P . . P . Q\n",
    ". . . P . . R .\n",
    ". . . . . . . P\n",
    ". R . . . . . K\n",
    "\"\"\"\n",
    "    prompt = f\"\"\"\n",
    "You are a chess AI with a chess skill above 1800 ELO rating.\n",
    "\n",
    "Position (FEN):\n",
    "{fen}\n",
    "\n",
    "Board (ASCII):\n",
    "{board_ascii}\n",
    "\n",
    "Which move leads to mate in 2?\n",
    "\n",
    "A) Qxh6+\n",
    "B) Bg7\n",
    "\n",
    "Respond ONLY with the option letter (e.g., A) or the exact move notation (e.g., Qxh6+). Do not include any other text.\n",
    "\"\"\"\n",
    "    response = llm.prompt(prompt).strip()\n",
    "\n",
    "    correct_answers = [\"A\", \"Qxh6+\"]\n",
    "\n",
    "    kbench.assertions.assert_in(\n",
    "        response,\n",
    "        correct_answers,\n",
    "        expectation=f\"The LLM should identify the correct mate in 2 move. Expected one of {correct_answers}, got '{response}'.\"\n",
    "    )\n",
    "\n",
    "chess_mate_in_2_puzzle.run(kbench.llm)"
   ]
  }
