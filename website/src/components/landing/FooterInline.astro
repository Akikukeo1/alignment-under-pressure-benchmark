---
// Ft2 Inline single line フッター(modern-minimal 既定)。
// knobs: order=wordmark·links·credit · separator=middot · density=dense
import { GITHUB_REPO, KAGGLE_BENCHMARK } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
	<div
		class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-2 gap-y-2 px-[clamp(1rem,4vw,1.5rem)] py-6 text-xs text-ink-3"
	>
		<span class="font-display font-semibold text-ink">AUPB</span>
		<span aria-hidden="true">·</span>
		<a
			href="/#about"
			class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>About / Contact</a
		>
		<span aria-hidden="true">·</span>
		<a
			href={GITHUB_REPO}
			target="_blank"
			rel="noopener noreferrer"
			class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>GitHub</a
		>
		<span aria-hidden="true">·</span>
		<a
			href={KAGGLE_BENCHMARK}
			target="_blank"
			rel="noopener noreferrer"
			class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>Kaggle</a
		>
		<span aria-hidden="true">·</span>
		<a
			href="/transparency"
			class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>透明性</a
		>
		<span aria-hidden="true">·</span>
		<a href="/reproducibility" class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>再現手順</a
		>
		<span aria-hidden="true">·</span>
		<a href="/paper" class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>論文PDF</a
		>
		<span aria-hidden="true">·</span>
		<a href="/license" class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>ライセンス</a
		>
		<span aria-hidden="true">·</span>
		<a
			href="/notes/ai-is-not-enough"
			class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
			>考察</a
		>
		<span class="ms-auto"
			>© {year} Keisuke Ishii · Content licensed under
			<a
				href="https://creativecommons.org/licenses/by/4.0/"
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-[4px] hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
				>CC BY 4.0</a
			></span
		>
	</div>
</footer>
