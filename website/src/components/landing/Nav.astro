---
// N1b SaaS three-section ナビ(Cobalt のボーダー式)。
// 中央にページ内リンク群、右側に ⌘K トリガーと塗りボタン。
import { ButtonLink } from '@/components/ui/button';
---

<header class="nav sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-[clamp(1rem,4vw,1.5rem)]">
		<!-- ブランド -->
		<a
			href="/"
			class="flex items-baseline gap-2 rounded-[4px] no-underline focus-visible:outline-2 focus-visible:outline-accent"
		>
			<span class="font-display text-lg font-semibold tracking-tight text-ink">AUPB</span>
			<span class="mono-label hidden text-[10px] text-ink-3 sm:inline">Benchmark</span>
		</a>

		<!-- 中央リンク群(狭い画面では非表示。⌘Kパレットが代替メニューになる) -->
		<nav class="nav-center-links hidden items-center gap-7 md:flex" aria-label="サイト内ナビゲーション">
			<a
				href="/results"
				class="link-grow rounded-[4px] text-sm font-medium text-ink-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
				>結果データ</a
			>
			<a
				href="/tasks"
				class="link-grow rounded-[4px] text-sm font-medium text-ink-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
				>タスク一覧</a
			>
			<a
				href="/reproducibility"
				class="link-grow rounded-[4px] text-sm font-medium text-ink-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
				>再現手順</a
			>
			<a
				href="/paper"
				class="link-grow rounded-[4px] text-sm font-medium text-ink-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">論文</a
			>
		</nav>

		<!-- 右端:⌘K トリガー + 塗りボタン -->
		<div class="flex items-center gap-3">
			<button
				id="cmdk-trigger"
				type="button"
				class="flex h-10 cursor-pointer items-center gap-2 rounded-[6px] border border-rule-2 px-3 text-xs text-ink-3 transition-colors outline-none hover:border-accent hover:text-accent focus-visible:ring-2 focus-visible:ring-accent active:translate-y-px"
				aria-label="検索・メニューを開く(Ctrl+K)"
				aria-haspopup="dialog"
				aria-expanded="false"
			>
				<span class="mono-label hidden sm:inline">Menu</span>
				<kbd class="font-mono text-[11px] leading-none">⌘K</kbd>
			</button>
			<ButtonLink href="/paper" size="sm" class="max-md:hidden">論文PDF</ButtonLink>
		</div>
	</div>

	<!-- JS無効環境では ⌘K パレットが使えないため、中央リンクを常に表示する -->
	<noscript>
		<style is:inline>
			.nav-center-links {
				display: flex !important;
			}
			#cmdk-trigger {
				display: none !important;
			}
		</style>
	</noscript>
</header>

<style>
	.nav {
		backdrop-filter: blur(8px);
	}
</style>
