---
// 論文PDFビューア。ブラウザ標準ビューアでの直接閲覧と、他リソースへの直接ジャンプを提供する。
// Starlight ページは Tailwind を読み込まないため、スタイルはこのスコープ内で完結させる。
import { GITHUB_REPO, KAGGLE_BENCHMARK } from '@/data/site';
import paperMeta from '@/data/paper.json';

const resources = [
	{ href: '/results', label: '結果データ' },
	{ href: '/tasks', label: 'タスク一覧' },
	{ href: '/reproducibility', label: '再現手順' },
	{ href: GITHUB_REPO, label: 'GitHub', external: true },
	{ href: KAGGLE_BENCHMARK, label: 'Kaggle', external: true },
];

const current = paperMeta.current;
const versions = paperMeta.versions;
// 先行公開版(preview)は main push ごとに作り直されるため時刻は持たず別扱い
const previewTag = paperMeta.preview;

const releaseUrl = (version: string) => `${GITHUB_REPO}/releases/tag/${version}`;

// UTC の ISO 8601 を JST の暦日と時刻へ整形する。
// タイムゾーンを明示指定するため、ビルド環境の TZ 設定に結果が左右されない。
function jstFormat(iso: string): { date: string; time: string } {
	const parts = new Intl.DateTimeFormat('ja-JP', {
		timeZone: 'Asia/Tokyo',
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
		hour: '2-digit',
		minute: '2-digit',
		hourCycle: 'h23',
	}).formatToParts(new Date(iso));
	const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
	return {
		date: `${get('year')}-${get('month')}-${get('day')}`,
		time: `${get('hour')}:${get('minute')}`,
	};
}

// 同じ日に複数回公開することが多いため、日付をグループ見出しにして行には時刻のみ出す。
// カードが伸びすぎないよう、履歴は直近 MAX_RECENT_VERSIONS 件に制限する
const MAX_RECENT_VERSIONS = 5;
const recentVersions = versions.slice(0, MAX_RECENT_VERSIONS);
const olderCount = versions.length - recentVersions.length;
const groups = Object.entries(
	recentVersions.reduce<Record<string, typeof versions>>((acc, v) => {
		const key = jstFormat(v.publishedAt).date;
		(acc[key] ??= []).push(v);
		return acc;
	}, {}),
);
---

<div class="paper-viewer">
	<!-- ツールバー:現行バージョン・直接表示・ダウンロード・リソースへの直接ジャンプ -->
	<div class="toolbar">
		<div class="primary-actions">
			{
				current && (
					<a
						class="version-badge"
						href={releaseUrl(current.version)}
						target="_blank"
						rel="noopener noreferrer"
						title="GitHub Release を開く"
					>
						現行版 {current.version}
						<span class="badge-date">{jstFormat(current.publishedAt).date} 公開</span>
					</a>
				)
			}
			<a
				class="btn btn-primary"
				href="/paper.pdf"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span aria-hidden="true">⛶</span> 全画面で開く<span class="ext" aria-hidden="true">↗</span>
			</a>
			<a class="btn btn-outline" href="/paper.pdf" download="AUPB_paper.pdf">PDFをダウンロード</a>
		</div>
		<nav class="resource-links" aria-label="関連リソース">
			{
				resources.map((r) => (
					<a
						class="chip"
						href={r.href}
						target={r.external ? '_blank' : undefined}
						rel={r.external ? 'noopener noreferrer' : undefined}
					>
						{r.label}
						{r.external && <span class="ext" aria-hidden="true">↗</span>}
					</a>
				))
			}
		</nav>
	</div>

	<!-- PDF 埋め込み(プレビュー用) -->
	<iframe src="/paper.pdf" title="Alignment Under Pressure Benchmark 論文"></iframe>

	<!-- バージョン履歴:直近数版の GitHub Release へのリンク + 常設の先行公開版 -->
	<!-- NOTE: h2 や ul/li を使うと Starlight 本文用タイポグラフィの干渉を受けるため div 構成にする -->
	{
		versions.length > 0 && (
			<nav class="versions" aria-label="論文のバージョン履歴">
				<div class="versions-head">
					<div class="versions-title">バージョン履歴</div>
					{previewTag && (
						<a
							class="preview-row"
							href={releaseUrl(previewTag.version)}
							target="_blank"
							rel="noopener noreferrer"
							title="常に最新状態を反映する先行公開版の GitHub Release を開く"
						>
							<svg class="pv-icon" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M21 12a9 9 0 1 1-2.64-6.36" />
								<path d="M21 3v6h-6" />
							</svg>
							<span class="pv-label">先行公開版</span>
							<svg class="row-ext" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M7 17 17 7M9 7h8v8" />
							</svg>
						</a>
					)}
				</div>
				{groups.map(([date, items]) => (
					<div class="vg">
						<div class="vg-date">{date}</div>
						{items.map((v) => (
							<a
								class="vrow"
								href={releaseUrl(v.version)}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="vname">{v.version}</span>
								{v.version === current?.version && <span class="tag tag-current">現行</span>}
								<span class="vtime">{jstFormat(v.publishedAt).time} 公開</span>
								<svg class="row-ext" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M7 17 17 7M9 7h8v8" />
								</svg>
							</a>
						))}
					</div>
				))}
				{
					olderCount > 0 && (
						<a
							class="more-link"
							href={`${GITHUB_REPO}/releases`}
							target="_blank"
							rel="noopener noreferrer"
						>
							残り {olderCount} 版を GitHub Releases で見る
							<svg class="row-ext" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M7 17 17 7M9 7h8v8" />
							</svg>
						</a>
					)
				}
			</nav>
		)
	}
</div>

<style>
	.paper-viewer {
		--pv-accent: var(--sl-color-accent-600, #2563eb);
		--pv-accent-hover: var(--sl-color-accent-700, #1d4ed8);
		--pv-rule: var(--sl-color-gray-5, #cbd5e1);

		margin-top: 1rem;
	}

	/* ---- ツールバー ---- */
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-bottom: 0.9rem;
	}
	.primary-actions {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 1rem;
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
		border: 1px solid transparent;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.btn:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}
	.btn-primary {
		background: var(--pv-accent);
		color: #fff;
	}
	.btn-primary:hover {
		background: var(--pv-accent-hover);
	}
	.btn-outline {
		background: transparent;
		border-color: var(--pv-rule);
		color: inherit;
	}
	.btn-outline:hover {
		border-color: var(--pv-accent);
		color: var(--pv-accent);
	}

	/* ---- 現行バージョン バッジ ---- */
	.version-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 1rem;
		border: 1px solid var(--pv-accent);
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		color: var(--pv-accent);
		white-space: nowrap;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.version-badge:hover {
		background: color-mix(in srgb, var(--pv-accent) 12%, transparent);
	}
	.badge-date {
		font-size: 0.75rem;
		font-weight: 500;
		opacity: 0.8;
	}

	.ext {
		font-size: 0.72em;
		opacity: 0.65;
	}

	/* ---- リソースチップ ---- */
	.resource-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-left: auto;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.32rem 0.75rem;
		border: 1px solid var(--pv-rule);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 500;
		text-decoration: none;
		color: inherit;
		/* 背景塗りを足して本文背景に溶けないようにする(ライト/ダーク両対応のトークン) */
		background: var(--sl-color-gray-6, #f1f5f9);
		white-space: nowrap;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background-color 0.15s ease;
	}
	.chip:hover {
		border-color: var(--pv-accent);
		color: var(--pv-accent);
	}
	.chip:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}

	/* ---- バージョン履歴(日付グループ+時刻行のチェンジログ風) ---- */
	/* NOTE: 見出し(h2)やリスト(ul/li)にすると Starlight 本文タイポグラフィに詳細度で負けるため div 構成 */
	.versions {
		margin-top: 1.1rem;
		padding: 0.7rem 0.95rem 0.6rem;
		border: 1px solid var(--pv-rule);
		border-radius: 10px;
		background: var(--sl-color-gray-6, #f1f5f9);
	}
	.versions-title {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		margin: 0;
		padding: 0;
	}
	/* タイトル行の右側に先行公開版を常設させる(履歴が長くなっても位置が不変) */
	.versions-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.2rem;
	}
	.preview-row {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--pv-accent) 55%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--pv-accent) 10%, transparent);
		color: inherit;
		text-decoration: none;
		font-size: 0.76rem;
		line-height: 1.3;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.preview-row:hover {
		background: color-mix(in srgb, var(--pv-accent) 20%, transparent);
	}
	.preview-row:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}
	.pv-icon {
		width: 0.95em;
		height: 0.95em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex-shrink: 0;
	}
	/* 表記は「先行公開版」の 1 種に絞る(preview・常に最新などは誤解や冗長さの元) */
	.pv-label {
		font-size: 0.78rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.vg-date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.75;
		margin: 0.45rem 0 0.05rem;
		font-variant-numeric: tabular-nums;
	}
	.vg-date::after {
		content: '';
		flex: 1;
		height: 1px;
		background: color-mix(in srgb, var(--pv-rule) 60%, transparent);
	}
	.vrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.4rem;
		border-radius: 6px;
		text-decoration: none;
		color: inherit;
		font-size: 0.85rem;
		line-height: 1.4;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.vrow:hover {
		background: color-mix(in srgb, var(--pv-accent) 10%, transparent);
	}
	.vrow:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: -2px;
	}
	.vname {
		font-family: var(--sl-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
		font-size: 0.82rem;
		font-weight: 600;
	}
	.vrow:hover .vname {
		color: var(--pv-accent);
	}
	.vtime {
		margin-left: auto;
		font-size: 0.72rem;
		opacity: 0.7;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	/* 行末の外部リンクアイコン(常時表示でリンクと分かるようにする) */
	.row-ext {
		width: 0.8em;
		height: 0.8em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex-shrink: 0;
		opacity: 0.45;
		margin-left: 0.1rem;
	}
	.vrow:hover .row-ext,
	.preview-row:hover .row-ext,
	.more-link:hover .row-ext {
		opacity: 1;
		color: var(--pv-accent);
	}
	.more-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		margin-top: 0.45rem;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--pv-rule);
		font-size: 0.75rem;
		text-decoration: none;
		color: inherit;
		opacity: 0.85;
		transition:
			color 0.15s ease,
			opacity 0.15s ease;
	}
	.more-link:hover {
		color: var(--pv-accent);
		opacity: 1;
	}
	.more-link:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.tag-current {
		background: var(--pv-accent);
		color: #fff;
	}

	/* ---- PDF 埋め込み ---- */
	iframe {
		width: 100%;
		height: 80vh;
		border: 1px solid var(--pv-rule);
		border-radius: 10px;
		background: #fff;
	}

	/* スマホなど狭い画面では iframe より直接開く導線を優先させるため高さを抑える */
	@media (max-width: 40rem) {
		iframe {
			height: 60vh;
		}
	}
</style>
