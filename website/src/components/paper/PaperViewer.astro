---
// 論文PDFビューア。ブラウザ標準ビューアでの直接閲覧と、他リソースへの直接ジャンプを提供する。
// Starlight ページは Tailwind を読み込まないため、スタイルはこのスコープ内で完結させる。
import { GITHUB_REPO, KAGGLE_BENCHMARK } from '@/data/site';
import paperMeta from '@/data/paper.json';

const resources = [
	{ href: '/results', label: '結果データ' },
	{ href: '/tasks', label: 'タスク一覧' },
	{ href: '/reproducibility', label: '再現手順' },
	{ href: GITHUB_REPO, label: 'GitHub', external: true },
	{ href: KAGGLE_BENCHMARK, label: 'Kaggle', external: true },
];

const current = paperMeta.current;
const versions = paperMeta.versions;

const releaseUrl = (version: string) => `${GITHUB_REPO}/releases/tag/${version}`;

// UTC の ISO 8601 を JST の暦日(YYYY-MM-DD)へ整形する。
// タイムゾーンを明示指定するため、ビルド環境の TZ 設定に結果が左右されない。
function jstDate(iso: string): string {
	const parts = new Intl.DateTimeFormat('ja-JP', {
		timeZone: 'Asia/Tokyo',
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	}).formatToParts(new Date(iso));
	const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
	return `${get('year')}-${get('month')}-${get('day')}`;
}
---

<div class="paper-viewer">
	<!-- ツールバー:現行バージョン・直接表示・ダウンロード・リソースへの直接ジャンプ -->
	<div class="toolbar">
		<div class="primary-actions">
			{
				current && (
					<a
						class="version-badge"
						href={releaseUrl(current.version)}
						target="_blank"
						rel="noopener noreferrer"
						title="GitHub Release を開く"
					>
						現行版 {current.version}
						<span class="badge-date">{jstDate(current.publishedAt)} 公開</span>
					</a>
				)
			}
			<a
				class="btn btn-primary"
				href="/paper.pdf"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span aria-hidden="true">⛶</span> 全画面で開く<span class="ext" aria-hidden="true">↗</span>
			</a>
			<a class="btn btn-outline" href="/paper.pdf" download="AUPB_paper.pdf">PDFをダウンロード</a>
		</div>
		<nav class="resource-links" aria-label="関連リソース">
			{
				resources.map((r) => (
					<a
						class="chip"
						href={r.href}
						target={r.external ? '_blank' : undefined}
						rel={r.external ? 'noopener noreferrer' : undefined}
					>
						{r.label}
						{r.external && <span class="ext" aria-hidden="true">↗</span>}
					</a>
				))
			}
		</nav>
	</div>

	<!-- PDF 埋め込み(プレビュー用) -->
	<iframe src="/paper.pdf" title="Alignment Under Pressure Benchmark 論文"></iframe>

	<!-- バージョン履歴:各版の GitHub Release へのリンク -->
	{
		versions.length > 0 && (
			<nav class="versions" aria-label="論文のバージョン履歴">
				<h2 class="versions-title">バージョン履歴</h2>
				<ul class="version-list">
					{versions.map((v) => (
						<li>
							<a
								class="chip"
								href={releaseUrl(v.version)}
								target="_blank"
								rel="noopener noreferrer"
							>
								{v.version}
								<span class="ver-date">{jstDate(v.publishedAt)}</span>
								{v.version === current?.version && <span class="tag tag-current">現行</span>}
								{v.prerelease && <span class="tag tag-pre">先行公開版</span>}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
</div>

<style>
	.paper-viewer {
		--pv-accent: var(--sl-color-accent-600, #2563eb);
		--pv-accent-hover: var(--sl-color-accent-700, #1d4ed8);
		--pv-rule: var(--sl-color-gray-5, #cbd5e1);

		margin-top: 1rem;
	}

	/* ---- ツールバー ---- */
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-bottom: 0.9rem;
	}
	.primary-actions {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 1rem;
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
		border: 1px solid transparent;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.btn:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}
	.btn-primary {
		background: var(--pv-accent);
		color: #fff;
	}
	.btn-primary:hover {
		background: var(--pv-accent-hover);
	}
	.btn-outline {
		background: transparent;
		border-color: var(--pv-rule);
		color: inherit;
	}
	.btn-outline:hover {
		border-color: var(--pv-accent);
		color: var(--pv-accent);
	}

	/* ---- 現行バージョン バッジ ---- */
	.version-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 1rem;
		border: 1px solid var(--pv-accent);
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		color: var(--pv-accent);
		white-space: nowrap;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.version-badge:hover {
		background: color-mix(in srgb, var(--pv-accent) 12%, transparent);
	}
	.badge-date {
		font-size: 0.75rem;
		font-weight: 500;
		opacity: 0.8;
	}

	.ext {
		font-size: 0.72em;
		opacity: 0.65;
	}

	/* ---- リソースチップ ---- */
	.resource-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-left: auto;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.32rem 0.75rem;
		border: 1px solid var(--pv-rule);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 500;
		text-decoration: none;
		color: inherit;
		white-space: nowrap;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.chip:hover {
		border-color: var(--pv-accent);
		color: var(--pv-accent);
	}
	.chip:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}

	/* ---- バージョン履歴 ---- */
	.versions {
		margin-top: 1.1rem;
	}
	.versions-title {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--sl-color-gray-6, #475569);
		border: none;
		margin: 0 0 0.5rem;
		padding: 0;
	}
	.version-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.ver-date {
		font-size: 0.72rem;
		opacity: 0.65;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.tag-current {
		background: var(--pv-accent);
		color: #fff;
	}
	.tag-pre {
		background: color-mix(in srgb, var(--sl-color-orange, #b45309) 18%, transparent);
		color: var(--sl-color-orange, #b45309);
	}

	/* ---- PDF 埋め込み ---- */
	iframe {
		width: 100%;
		height: 80vh;
		border: 1px solid var(--pv-rule);
		border-radius: 10px;
		background: #fff;
	}

	/* スマホなど狭い画面では iframe より直接開く導線を優先させるため高さを抑える */
	@media (max-width: 40rem) {
		iframe {
			height: 60vh;
		}
	}
</style>
