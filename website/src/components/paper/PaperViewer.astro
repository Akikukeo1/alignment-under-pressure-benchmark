---
// 論文PDFビューア。ブラウザ標準ビューアでの直接閲覧と、他リソースへの直接ジャンプを提供する。
// Starlight ページは Tailwind を読み込まないため、スタイルはこのスコープ内で完結させる。
import { GITHUB_REPO, KAGGLE_BENCHMARK } from '@/data/site';

const resources = [
	{ href: '/results', label: '結果データ' },
	{ href: '/tasks', label: 'タスク一覧' },
	{ href: '/reproducibility', label: '再現手順' },
	{ href: GITHUB_REPO, label: 'GitHub', external: true },
	{ href: KAGGLE_BENCHMARK, label: 'Kaggle', external: true },
];
---

<div class="paper-viewer">
	<!-- ツールバー:直接表示・ダウンロード・リソースへの直接ジャンプ -->
	<div class="toolbar">
		<div class="primary-actions">
			<a
				class="btn btn-primary"
				href="/paper.pdf"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span aria-hidden="true">⛶</span> 全画面で開く<span class="ext" aria-hidden="true">↗</span>
			</a>
			<a class="btn btn-outline" href="/paper.pdf" download="AUPB_paper.pdf">PDFをダウンロード</a>
		</div>
		<nav class="resource-links" aria-label="関連リソース">
			{
				resources.map((r) => (
					<a
						class="chip"
						href={r.href}
						target={r.external ? '_blank' : undefined}
						rel={r.external ? 'noopener noreferrer' : undefined}
					>
						{r.label}
						{r.external && <span class="ext" aria-hidden="true">↗</span>}
					</a>
				))
			}
		</nav>
	</div>

	<!-- PDF 埋め込み(プレビュー用) -->
	<iframe src="/paper.pdf" title="Alignment Under Pressure Benchmark 論文"></iframe>
</div>

<style>
	.paper-viewer {
		--pv-accent: var(--sl-color-accent-600, #2563eb);
		--pv-accent-hover: var(--sl-color-accent-700, #1d4ed8);
		--pv-rule: var(--sl-color-gray-5, #cbd5e1);

		margin-top: 1rem;
	}

	/* ---- ツールバー ---- */
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-bottom: 0.9rem;
	}
	.primary-actions {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 1rem;
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
		border: 1px solid transparent;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.btn:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}
	.btn-primary {
		background: var(--pv-accent);
		color: #fff;
	}
	.btn-primary:hover {
		background: var(--pv-accent-hover);
	}
	.btn-outline {
		background: transparent;
		border-color: var(--pv-rule);
		color: inherit;
	}
	.btn-outline:hover {
		border-color: var(--pv-accent);
		color: var(--pv-accent);
	}

	.ext {
		font-size: 0.72em;
		opacity: 0.65;
	}

	/* ---- リソースチップ ---- */
	.resource-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-left: auto;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.32rem 0.75rem;
		border: 1px solid var(--pv-rule);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 500;
		text-decoration: none;
		color: inherit;
		white-space: nowrap;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.chip:hover {
		border-color: var(--pv-accent);
		color: var(--pv-accent);
	}
	.chip:focus-visible {
		outline: 2px solid var(--pv-accent);
		outline-offset: 2px;
	}

	/* ---- PDF 埋め込み ---- */
	iframe {
		width: 100%;
		height: 80vh;
		border: 1px solid var(--pv-rule);
		border-radius: 10px;
		background: #fff;
	}

	/* スマホなど狭い画面では iframe より直接開く導線を優先させるため高さを抑える */
	@media (max-width: 40rem) {
		iframe {
			height: 60vh;
		}
	}
</style>
