---
// results.json(スクリプト生成)から表を描画するコンポーネント。
// kind で表示する表を切り替える:overall=総合スコア / gap=平常時と圧力下のギャップ / category=カテゴリ別得点。
// Starlight ページは Tailwind を読み込まないため、スタイルはこのスコープ内で完結させる。
import results from '@/data/results.json';
import { shortModel } from '@/data/site';

interface Props {
	kind: 'overall' | 'gap' | 'category';
}

const { kind } = Astro.props;

/** 数値を2桁固定で整形 */
const fmt2 = (n: number) => n.toFixed(2);
/** マイナス値を組版上のマイナス記号(U+2212)に置き換えて3桁固定 */
const fmtDelta = (n: number) => n.toFixed(3).replace('-', '−');
/** 平均値に添える95%信頼区間 */
const fmtCI = (ci: (number | null)[]) =>
	ci.length === 2 && ci.every((value) => value !== null)
		? `[${fmt2(ci[0] as number)}, ${fmt2(ci[1] as number)}]`
		: '—';
const fmtP = (p: number | null) => (p === null ? '—' : p < 0.001 ? '<0.001' : `=${p.toFixed(3)}`);

// キャプション用:圧力耐性比が最も高いモデルの低下幅と、低下幅が最大のモデルの値を実データから導出する
const mostResistantDelta = Math.min(
	...results.gap.filter((g) => g.resistance === Math.max(...results.gap.map((x) => x.resistance))).map((g) => g.delta),
);
const largestDropDelta = Math.min(...results.gap.map((g) => g.delta));
---

{
	kind === 'overall' && (
		<table class="results-table">
			<thead>
				<tr>
					<th>モデル</th>
					<th class="num">総合スコア<br /><small>95% CI</small></th>
				</tr>
			</thead>
			<tbody>
				{results.overall.map((row, i) => (
					<tr class={i === 0 ? 'top' : undefined}>
						<td class="model">{shortModel(row.model)}</td>
						<td class="num">
							<strong>{fmt2(row.score)}</strong>
							<br /><small>{fmtCI(row.scoreCI)}</small>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}

{
	kind === 'gap' && (
		<>
			<p class="caption">
				全モデルが平常時より圧力下でスコアを落としています。圧力耐性比が最も高いモデルでも{' '}
				{fmtDelta(mostResistantDelta)}pt、最も脆いモデルでは {fmtDelta(largestDropDelta)}pt の低下です。
			</p>
			<table class="results-table">
				<thead>
					<tr>
						<th>モデル</th>
						<th class="num">Avg Normal<br /><small>95% CI</small></th>
						<th class="num">Avg Pressure<br /><small>95% CI</small></th>
						<th class="num">Avg Δ (Gap)<br /><small>95% CI</small></th>
						<th class="num">圧力耐性比</th>
					</tr>
				</thead>
				<tbody>
					{results.gap.map((row, i) => (
						<tr class={i === 0 ? 'top' : undefined}>
							<td class="model">{shortModel(row.model)}</td>
							<td class="num">{fmt2(row.normal)}<br /><small>{fmtCI(row.normalCI)}</small></td>
							<td class="num">{fmt2(row.pressure)}<br /><small>{fmtCI(row.pressureCI)}</small></td>
							<td class="num">{fmtDelta(row.delta)}<br /><small>{fmtCI(row.deltaCI)}</small></td>
							<td class="num">
								<strong>{fmtDelta(row.resistance)}</strong>
							</td>
						</tr>
					))}
				</tbody>
			</table>
			{(() => {
				const modelTest = results.statistics.tests.find((test) => test.pairedUnit === 'Model');
				const taskTest = results.statistics.tests.find((test) => test.pairedUnit === 'Task');
				return (
					<p class="caption statistics-note">
						全体差の対応のあるt検定（モデル平均、n={modelTest?.n ?? '—'}）: p{fmtP(modelTest?.pairedTPvalue ?? null)}。Wilcoxon符号付順位検定: p{fmtP(modelTest?.wilcoxonPvalue ?? null)}。タスク平均を対応単位にすると t検定 p{fmtP(taskTest?.pairedTPvalue ?? null)}、Wilcoxon検定 p{fmtP(taskTest?.wilcoxonPvalue ?? null)} です。
					</p>
				);
			})()}
		</>
	)
}

{
	kind === 'category' && (
		<table class="results-table">
			<thead>
				<tr>
					<th>カテゴリ</th>
					{results.categoryMatrix.models.map((m) => (
						<th class="num model">{shortModel(m)}</th>
					))}
				</tr>
			</thead>
			<tbody>
				{results.categoryMatrix.categories.map((cat, ci) => (
					<tr>
						<td>{cat}</td>
						{results.categoryMatrix.values[ci].map((v) => (
							<td class="num">{fmt2(v)}</td>
						))}
					</tr>
				))}
			</tbody>
		</table>
	)
}

<style>
	.results-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		margin-block: 1rem;
	}
	th,
	td {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-gray-6, #e2e8f0);
		text-align: left;
	}
	thead th {
		border-bottom-width: 2px;
		font-size: 0.8rem;
	}
	.num {
		text-align: right;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	td.model,
	th.model {
		font-family: var(--__sl_font_mono, ui-monospace), ui-monospace, monospace;
		font-size: 0.78rem;
	}
	tr.top td {
		color: var(--sl-color-white, #1e293b);
	}
	.caption {
		font-size: 0.9rem;
		color: var(--sl-color-gray-3, #64748b);
	}
	.statistics-note {
		font-size: 0.8rem;
	}
	small {
		font-weight: normal;
		color: var(--sl-color-gray-3, #64748b);
	}
</style>
