---
// タスク定義 TOML をビルド時に読み込み、一覧表示するコンポーネント。
// Starlight ページは Tailwind を読み込まないため、スタイルはこのスコープ内で完結させる。
import { readFileSync, readdirSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { parse } from 'smol-toml';
import { GITHUB_REPO } from '@/data/site';

interface TaskDef {
	category: string;
	difficulty: string;
	name: string;
	autopush?: boolean;
}

interface TaskFile {
	file: string;
	task: TaskDef;
	grader: {
		type: string;
		answers?: string[];
		forbidden?: string[];
		max_length?: number;
		require_choice_only?: boolean;
	};
	prompt: { system: string; user: string };
	normal_prompt?: { system: string; user: string };
}

// website/ の外側にある ../tasks/ はリポジトリ全体がチェックアウトされていれば存在する
const tasksDir = resolve(process.cwd(), '../tasks');
const files = readdirSync(tasksDir)
	.filter((f) => f.endsWith('.toml'))
	.sort();

const tasks = files.map((file): TaskFile => {
	const parsed = parse(readFileSync(join(tasksDir, file), 'utf-8')) as unknown as TaskFile;
	return { file, ...parsed };
});

const categoryOrder = ['Bias', 'Ethics', 'Logic', 'Robustness', 'Safety'];
tasks.sort(
	(a, b) =>
		categoryOrder.indexOf(a.task.category) - categoryOrder.indexOf(b.task.category) ||
		a.file.localeCompare(b.file),
);

const difficultyOrder = ['E', 'M', 'H', 'INS', 'INS+', 'INP'];
const difficultyLabels: Record<string, string> = {
	E: 'Easy',
	M: 'Medium',
	H: 'Hard',
	INS: 'Insane',
	'INS+': 'Insane+',
	INP: 'Impossible',
};

function diffRank(d: string): number {
	return difficultyOrder.indexOf(d);
}

/** grader の判定基準を人間可読な文字列に整形する */
function graderLabel(t: TaskFile): string {
	const g = t.grader;
	if (g.type === 'forbidden_choice') {
		// 禁止選択肢方式:禁止トークン以外(回答拒否を含む)なら正答
		return `正答 = ${(g.forbidden ?? []).join(' / ')} 以外の選択肢`;
	}
	if (g.require_choice_only) {
		// 選択肢のみで回答させる方式(max_length は判定に使われない)
		return `正解 ${g.answers?.join(' / ')}`;
	}
	const len = g.max_length ? ` · 応答長が ${g.max_length} 文字を超える場合は選択肢を明示しなかったものとして正答` : '';
	return `正解 ${g.answers?.join(' / ')}${len}`;
}
---

<div class="task-list">
	{
		tasks.map((t) => (
			<details class="task">
				<summary>
					<span class="meta">
						<span class={`chip chip-diff diff-${t.task.difficulty.toLowerCase().replace('+', 'p')}`}>
							{difficultyLabels[t.task.difficulty] ?? t.task.difficulty}
						</span>
						<span class="chip">{t.task.category}</span>
					</span>
					<span class="name">{t.task.name}</span>
					<span class="hint">クリックで展開</span>
				</summary>

				<div class="body">
					<p class="grader">
						Grader: {graderLabel(t)}
					</p>

					{t.normal_prompt?.system && (
						<>
							<h5 class="label">平常時システムプロンプト(Normal)</h5>
							<pre>{t.normal_prompt.system.trim()}</pre>
						</>
					)}

					{t.normal_prompt && (
						<>
							<h5 class="label">平常時プロンプト(Normal)</h5>
							<pre>{t.normal_prompt.user.trim()}</pre>
						</>
					)}

					{t.prompt.system && (
						<>
							<h5 class="label">圧力下システムプロンプト(Pressure)</h5>
							<pre class="pressure">{t.prompt.system.trim()}</pre>
						</>
					)}

					<h5 class="label">圧力下プロンプト(Pressure)</h5>
					<pre class="pressure">{t.prompt.user.trim()}</pre>

					<a
						class="source"
						href={`${GITHUB_REPO}/blob/main/tasks/${t.file}`}
						target="_blank"
						rel="noopener noreferrer"
					>
						TOML を GitHub で見る ↗
					</a>
				</div>
			</details>
		))
	}
</div>

<style>
	/* 難易度バッジの色トークン。難しさの順に濃さを上げる */
	.task-list {
		--chip-diff-e-bg: #dbeafe;
		--chip-diff-e-ink: #1e40af;
		--chip-diff-m-bg: #d1fae5;
		--chip-diff-m-ink: #065f46;
		--chip-diff-h-bg: #fef3c7;
		--chip-diff-h-ink: #92400e;
		--chip-diff-ins-bg: #fee2e2;
		--chip-diff-ins-ink: #991b1b;
		--chip-diff-insp-bg: #f3e8ff;
		--chip-diff-insp-ink: #6b21a8;

		/* Starlight の gray スケールはダーク/ライトでスケール方向・定義数が異なるため、
		 自前のトークンで両モード分を明示する(ダークモードは data-theme で上書き) */
		--task-chip-bg: #e2e8f0; /* カテゴリチップ背景 */
		--task-chip-ink: #1e293b;
		--task-border: #cbd5e1; /* カード境界線 */
		--task-body-border: #e2e8f0;
		--task-muted: #64748b; /* 補助テキスト */
		--task-faint: #94a3b8; /* さらに薄いテキスト(hint) */
		--task-pre-bg: #f1f5f9; /* プロンプトコードブロック背景 */
		--task-pre-ink: #334155;
	}

	/* ダークモード:Starlight の data-theme 属性に追従して明示的に反転する */
	:global([data-theme='dark']) .task-list {
		--task-chip-bg: hsl(224, 14%, 16%);
		--task-chip-ink: hsl(224, 20%, 94%);
		--task-border: hsl(224, 10%, 23%);
		--task-body-border: hsl(224, 14%, 16%);
		--task-muted: hsl(224, 6%, 60%);
		--task-faint: hsl(224, 6%, 48%); /* hint は muted より一段薄く、ただし可読性を確保 */
		--task-pre-bg: hsl(224, 14%, 16%);
		--task-pre-ink: hsl(224, 20%, 94%);
	}

	/* 難易度バッジ */
	.chip {
		display: inline-block;
		padding: 0.1rem 0.5rem;
		border-radius: 4px;
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.5;
		background: var(--task-chip-bg);
		color: var(--task-chip-ink);
	}
	.diff-e {
		background: var(--chip-diff-e-bg);
		color: var(--chip-diff-e-ink);
	}
	.diff-m {
		background: var(--chip-diff-m-bg);
		color: var(--chip-diff-m-ink);
	}
	.diff-h {
		background: var(--chip-diff-h-bg);
		color: var(--chip-diff-h-ink);
	}
	.diff-ins {
		background: var(--chip-diff-ins-bg);
		color: var(--chip-diff-ins-ink);
	}
	.diff-insp {
		background: var(--chip-diff-insp-bg);
		color: var(--chip-diff-insp-ink);
	}

	.task-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.task {
		border: 1px solid var(--task-border);
		border-radius: 10px;
		overflow: hidden;
		background: var(--sl-color-bg);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding: 0.85rem 1.1rem;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.meta {
		display: flex;
		gap: 0.35rem;
	}
	.name {
		font-family: var(--__sl_font, ui-monospace), ui-monospace, monospace;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.hint {
		margin-left: auto;
		font-size: 0.75rem;
		color: var(--task-faint);
	}
	details[open] .hint {
		display: none;
	}

	.body {
		padding: 0 1.1rem 1.1rem;
		border-top: 1px solid var(--task-body-border);
	}
	.grader {
		margin-top: 0.9rem;
		font-size: 0.82rem;
		color: var(--task-muted);
	}
	.label {
		margin: 1rem 0 0.35rem;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--task-muted);
	}
	pre {
		margin: 0;
		padding: 0.9rem 1rem;
		border-radius: 8px;
		font-size: 0.8rem;
		line-height: 1.55;
		white-space: pre-wrap;
		word-break: break-word;
		background: var(--task-pre-bg);
		color: var(--task-pre-ink);
	}
	pre.pressure {
		/* 圧力下プロンプトにはコバルトのマーカーを付ける */
		border-left: 3px var(--sl-color-accent-600, #2563eb) solid;
	}
	.source {
		display: inline-block;
		margin-top: 0.9rem;
		font-size: 0.8rem;
	}
</style>
