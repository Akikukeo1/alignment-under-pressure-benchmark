---
// 404 ページ。ランディングと同じ Cobalt トークン・レイアウトを共有する。
// ユーザー定義ルートが Starlight 内蔵の 404 より優先されるため、このページが配信される。
import LandingLayout from '@/layouts/LandingLayout.astro';
import Nav from '@/components/landing/Nav.astro';
import FooterInline from '@/components/landing/FooterInline.astro';
import { ButtonLink } from '@/components/ui/button';

const resources = [
	{ href: '/results', label: '結果データ' },
	{ href: '/tasks', label: 'タスク一覧' },
	{ href: '/paper', label: '論文PDF' },
];
---

<LandingLayout
	title="404 Not Found - AUPB"
	description="お探しのページは見つかりませんでした。AUPBの各ページへのリンクから目的のコンテンツをお探しください。"
>
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-[6px] focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-accent-ink"
		>本文へスキップ</a
	>
	<Nav />
	<main id="main">
		<section class="border-b border-rule">
			<div class="mx-auto max-w-6xl px-[clamp(1rem,4vw,1.5rem)] pt-14 pb-20 md:pt-20 md:pb-28">
				<p class="mono-label text-xs text-accent">Error</p>

				<!-- 数字と言葉を必ずペアで見せる(Stat-Led の規律を踏襲) -->
				<div class="mt-6 flex flex-col gap-6 md:mt-8 md:flex-row md:items-end md:gap-12">
					<div class="tnum font-display text-[clamp(4.5rem,14vw,10rem)] leading-none font-semibold tracking-tight text-ink">
						404
					</div>
					<div class="max-w-xl">
						<h1 class="font-display text-2xl font-semibold text-balance text-ink md:text-3xl">
							お探しのページは見つかりませんでした。
						</h1>
						<p class="mt-3 text-sm leading-relaxed text-ink-3 md:text-base">
							URLが変更されたか、移動・削除された可能性があります。以下のリンクから目的のコンテンツにアクセスできます。
						</p>
					</div>
				</div>

				<div class="mt-10 flex flex-wrap items-center gap-4">
					<ButtonLink href="/" size="lg">ホームに戻る</ButtonLink>
					{
						resources.map((r) => (
							<ButtonLink href={r.href} variant="outline" size="lg">
								{r.label}
							</ButtonLink>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<FooterInline />
</LandingLayout>
