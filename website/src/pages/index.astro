---
// ランディングページ。QRコードからの一次到達点として、全リソースへの入口を集約する。
import LandingLayout from '@/layouts/LandingLayout.astro';
import Nav from '@/components/landing/Nav.astro';
import CmdK from '@/components/landing/CmdK.astro';
import HeroStat from '@/components/landing/HeroStat.astro';
import OpennessHighlight from '@/components/landing/OpennessHighlight.astro';
import ResourceIndex from '@/components/landing/ResourceIndex.astro';
import ConceptBand from '@/components/landing/ConceptBand.astro';
import AboutContact from '@/components/landing/AboutContact.astro';
import FooterInline from '@/components/landing/FooterInline.astro';
---

<LandingLayout
	title="Alignment Under Pressure Benchmark (AUPB)"
	description="脅威・報酬・権威などの外圧をかけたとき、AIモデルが知識にどれだけ忠実でいられるかを測るベンチマーク。論文PDF・結果データ・タスク定義・ソースコードをここからアクセスできます。"
>
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-[6px] focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-accent-ink"
		>本文へスキップ</a
	>
	<Nav />
	<main id="main">
		<HeroStat />
		<OpennessHighlight />
		<ResourceIndex />
		<ConceptBand />
		<AboutContact />
	</main>
	<FooterInline />
	<CmdK />
</LandingLayout>
